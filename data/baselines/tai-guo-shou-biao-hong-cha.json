{
  "id": "tai-guo-shou-biao-hong-cha",
  "name": "泰国手标红茶",
  "category": "饮品",
  "tags": [
    "快手",
    "省事"
  ],
  "summary": "这是一道源自泰国街头的经典奶茶，茶香浓郁，口感绵密顺滑，炼乳与牛奶带来香甜奶味。茶奶结合可提供少量蛋白质和钙，但含糖量较高，适宜作为消暑解渴的饮品。制作步骤简单，但需反复过滤茶汤并等待长时间冷藏，整体耗时约 4 小时 20 分钟，对新手稍有耐心即可完成。",
  "difficulty": 2,
  "servings": 1,
  "cookMinutes": 20,
  "ingredients": [
    {
      "name": "水",
      "note": "600cc"
    },
    {
      "name": "茶粉",
      "note": "20g"
    },
    {
      "name": "白糖",
      "note": "24g"
    },
    {
      "name": "牛奶",
      "note": "18ml"
    },
    {
      "name": "炼乳",
      "note": "24g"
    },
    {
      "name": "克称"
    },
    {
      "name": "带刻度容器"
    },
    {
      "name": "港式奶茶过滤袋"
    }
  ],
  "steps": [
    {
      "text": "600cc 水大火烧开",
      "heat": "大火"
    },
    {
      "text": "在过滤袋中装入 20g 茶粉，开水倒入过滤袋中，过滤 20 遍"
    },
    {
      "text": "使用克称量取 24g 炼乳、24g 白糖和 18ml 牛奶放入 1000ml 以上的水壶中"
    },
    {
      "text": "将过滤好的茶水倒入水壶中搅拌，直到白糖融化"
    },
    {
      "text": "将水壶放到冰箱 4 小时以上"
    },
    {
      "text": "喝前可以加 6-8 颗冰块"
    }
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
