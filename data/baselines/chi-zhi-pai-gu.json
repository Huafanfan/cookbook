{
  "id": "chi-zhi-pai-gu",
  "name": "豉汁排骨",
  "category": "家常菜",
  "tags": [
    "下饭",
    "一锅出",
    "重口"
  ],
  "summary": "这是一道粤式茶楼里的人气蒸点，豉香醇厚，排骨滑嫩脱骨。排骨提供优质蛋白和钙质，发酵豆豉增添风味也更利吸收。做法需经过泡洗、腌制和控火蒸制，对新手稍有考验，但步骤清晰易上手，从备料到出锅大约只需 1 小时。剩余的汤汁用来拌饭或拌面格外鲜美。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "肋排",
      "amount": 500,
      "unit": "g"
    },
    {
      "name": "阳江豆豉",
      "amount": 15,
      "unit": "g"
    },
    {
      "name": "蒜蓉",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "姜末",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "生抽",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "老抽",
      "amount": 3,
      "unit": "ml"
    },
    {
      "name": "蚝油",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "白砂糖",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "生粉",
      "amount": 8,
      "unit": "g"
    },
    {
      "name": "食用油",
      "amount": 20,
      "unit": "ml",
      "note": "不打算淋热油为 10 ml"
    },
    {
      "name": "清水",
      "amount": 30,
      "unit": "ml"
    },
    {
      "name": "葱花",
      "note": "可选"
    },
    {
      "name": "白芝麻",
      "note": "可选"
    }
  ],
  "steps": [
    {
      "text": "将排骨用冷水浸泡 10 分钟泡去血水，换水重复 2 次，用厨房纸吸干",
      "minutes": 10
    },
    {
      "text": "将豆豉放入水中浸泡 5 分钟",
      "minutes": 5
    },
    {
      "text": "将所有食材混合（食用油放 10 ml），腌制 8-30 分钟",
      "minutes": 8
    },
    {
      "text": "水开后上锅蒸 18 分钟",
      "minutes": 18
    },
    {
      "text": "焖 2 分钟",
      "minutes": 2
    },
    {
      "text": "锅中倒入 10 ml 热油，加热到 180-200 ℃"
    },
    {
      "text": "均匀撒上葱花和白芝麻，热油浇在撒料上"
    }
  ],
  "tips": [
    "豆豉浸泡后稍微剁碎会更入味",
    "蒸制时间随排骨大小调整，以筷子能轻松插入软骨处为准",
    "传统的豉汁排骨不放撒料和淋热油",
    "吃剩的汤汁可以用来拌饭或者拌面"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
