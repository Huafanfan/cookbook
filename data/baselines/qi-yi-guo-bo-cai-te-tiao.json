{
  "id": "qi-yi-guo-bo-cai-te-tiao",
  "name": "奇异果菠菜特调",
  "category": "饮品",
  "tags": [
    "酸甜",
    "快手",
    "省事"
  ],
  "summary": "这是一道清爽健康的果蔬特饮，口感酸甜细腻，带有奇异果与苹果的天然果香，菠菜味清淡不抢。富含维生素 C 和膳食纤维，有助于促进消化。制作非常简单，新手也能一次成功，全程预计只需 10 分钟。",
  "difficulty": 1,
  "servings": 2,
  "cookMinutes": 10,
  "ingredients": [
    {
      "name": "饮用水",
      "amount": 700,
      "unit": "ml"
    },
    {
      "name": "奇异果",
      "amount": 2,
      "unit": "个"
    },
    {
      "name": "苹果",
      "amount": 1,
      "unit": "/2",
      "note": "个"
    },
    {
      "name": "菠菜叶",
      "amount": 4,
      "unit": "叶"
    },
    {
      "name": "白砂糖",
      "amount": 12,
      "unit": "克"
    },
    {
      "name": "原料"
    },
    {
      "name": "- 水"
    },
    {
      "name": "工具"
    },
    {
      "name": "- 榨汁机"
    }
  ],
  "steps": [
    {
      "text": "将猕猴桃切成两半，每半再分四份小块"
    },
    {
      "text": "将苹果切丁"
    },
    {
      "text": "将菠菜叶去梗，只留叶子部分"
    },
    {
      "text": "将菠菜切碎"
    },
    {
      "text": "一起倒入榨汁机搅拌杯"
    },
    {
      "text": "注水"
    },
    {
      "text": "加入白砂糖"
    },
    {
      "text": "启动搅拌机，搅拌约 4 个 15 秒（每 15 秒停下看状态）"
    }
  ],
  "tips": [
    "关于白砂糖的量：全糖为 12g，可根据个人情况在 0-12g 中调整",
    "本品是仿照宜家的奇异果菠菜汁自己研制的，没有宜家的好喝，但也不错",
    "欢迎改进！"
  ],
