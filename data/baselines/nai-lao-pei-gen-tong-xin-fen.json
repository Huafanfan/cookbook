{
  "id": "nai-lao-pei-gen-tong-xin-fen",
  "name": "奶酪培根通心粉",
  "category": "家常菜",
  "tags": [
    "重口"
  ],
  "summary": "奶酪培根通心粉是经典美式家常菜，口感浓郁绵密，奶酪包裹弹牙通心粉，搭配香脆培根，咸香满足。富含蛋白质与钙质，但热量和脂肪较高，建议偶尔享用。制作需要一定耐心，掌握基础白酱和火候对新手略有挑战，整体难度中等。不烘烤时约 30 分钟即可上桌，若选择烘烤需额外预热和烤制，总时长约 1 小时。",
  "difficulty": 2,
  "servings": 2,
  "cookMinutes": 30,
  "ingredients": [
    {
      "name": "通心粉",
      "amount": "100-125",
      "unit": "g"
    },
    {
      "name": "奶酪",
      "amount": "40-55",
      "unit": "g，若要烘烤额外准备",
      "note": "25g， 条状"
    },
    {
      "name": "培根或其他肉类",
      "amount": "100-125",
      "unit": "g"
    },
    {
      "name": "洋葱",
      "amount": 25,
      "unit": "g-40g",
      "note": "切成碎"
    },
    {
      "name": "黄油",
      "amount": 15,
      "unit": "g"
    },
    {
      "name": "面粉",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "牛奶",
      "amount": 125,
      "unit": "ml"
    },
    {
      "name": "大蒜半瓣，切碎"
    }
  ],
  "steps": [
    {
      "text": "奶酪要磨成碎末"
    },
    {
      "text": "洋葱切成条状"
    },
    {
      "text": "通心粉用微咸的水煮 6 分钟",
      "minutes": 6
    },
    {
      "text": "**中火**",
      "heat": "中火"
    },
    {
      "text": "锅中放入黄油，等待融化"
    },
    {
      "text": "加入洋葱"
    },
    {
      "text": "洋葱软化后加入大蒜"
    },
    {
      "text": "大蒜香味出来后，加入肉类，等待 5 秒"
    },
    {
      "text": "**小火**",
      "heat": "小火"
    },
    {
      "text": "分四次加入牛奶，每次搅拌 5 秒后再加下一次"
    },
    {
      "text": "加入面粉并充分搅拌"
    },
    {
      "text": "加入奶酪并搅拌均匀"
    },
    {
      "text": "将通心粉和奶酪搅拌"
    },
    {
      "text": "如果不打算烘烤，可以直接吃了"
    },
    {
      "text": "**烘烤：**"
    },
    {
      "text": "预热烤箱至 180°C"
    },
    {
      "text": "将额外的 50g 芝士铺在通心粉之上"
    },
    {
      "text": "等待烤箱预热至 180°C 后，将通心粉放入"
    },
    {
      "text": "烤至表面金黄,约 24 分钟",
      "minutes": 24
    }
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
