{
  "id": "liang-ban-huang-gua",
  "name": "凉拌黄瓜",
  "category": "家常菜",
  "tags": [
    "快手",
    "新手友好",
    "清淡"
  ],
  "summary": "这是一道清爽开胃的家常凉菜，口感脆嫩，酸香适口。黄瓜富含水分和维生素，有助于清热解暑、美容养颜。做法非常简单，对新手友好，只需拍碎、调味、腌制 15 分钟，全程约 20 分钟即可完成。",
  "difficulty": 1,
  "servings": 1,
  "ingredients": [
    {
      "name": "黄瓜",
      "amount": 200,
      "unit": "克",
      "note": "份数"
    },
    {
      "name": "醋 7.5 ml +",
      "amount": 4,
      "unit": "ml",
      "note": "份数"
    },
    {
      "name": "酱油",
      "amount": 5,
      "unit": "ml",
      "note": "+ 2.5 ml * 份数"
    },
    {
      "name": "蒜",
      "amount": 3,
      "unit": "瓣",
      "note": "份数"
    },
    {
      "name": "盐 0.4 克 +",
      "amount": 0.2,
      "unit": "克",
      "note": "份数"
    },
    {
      "name": "香油",
      "amount": 5,
      "unit": "ml",
      "note": "+ 2 ml * 份数"
    },
    {
      "name": "蚝油",
      "amount": 5,
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "用菜刀将黄瓜拍扁，再剁成长 3 厘米的碎块"
    },
    {
      "text": "将碎黄瓜装入碗中"
    },
    {
      "text": "将蒜拍碎切成碎末"
    },
    {
      "text": "将碗中放入 5 克白糖，搅拌均匀腌制 15 分钟（用糖腌制更好吃，且成色更好不会蔫）",
      "minutes": 15
    },
    {
      "text": "将醋，酱油，盐，蚝油和蒜依次倒入碗中搅拌均匀"
    },
    {
      "text": "将香油倒入碗中并均匀搅拌"
    }
  ],
  "tips": [
    "部分情况下黄瓜端头有苦味，请洗净切下后确认",
    "做好之后直接开吃，亦可先准备好后放入冰箱冷藏（并非冷冻）后食用",
    "若放入冰箱冷藏，则需使用保鲜膜包紧，并在 8 小时内食用完毕，否则黄瓜会因过度腌制失去清脆口感",
    "推荐黄瓜去皮，口感更好"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
