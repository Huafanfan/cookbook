{
  "id": "re-gan-mian",
  "name": "热干面",
  "category": "主食",
  "tags": [
    "重口",
    "辣"
  ],
  "summary": "热干面是武汉最具代表性的小吃之一，属于鄂菜系。碱水面条筋道爽滑，裹满浓稠的芝麻酱，搭配酸豆角、萝卜干和肉末，咸香微辣，滋味醇厚。主要提供碳水化合物和蛋白质，芝麻酱也富含钙质。制作简单快捷，新手也能轻松上手，从煮面到拌好大约只需十几分钟。",
  "difficulty": 2,
  "servings": 2,
  "ingredients": [
    {
      "name": "热干面特有的碱水面",
      "note": "250g"
    },
    {
      "name": "小葱",
      "note": "10g"
    },
    {
      "name": "酸豆角",
      "note": "20g"
    },
    {
      "name": "肉末",
      "note": "30g"
    },
    {
      "name": "蒜水",
      "note": "30ml"
    },
    {
      "name": "肉汤汁",
      "note": "30ml"
    },
    {
      "name": "萝卜干",
      "note": "50g"
    },
    {
      "name": "芝麻酱",
      "note": "40ml"
    },
    {
      "name": "辣椒油",
      "note": "0-10ml"
    },
    {
      "name": "胡椒粉",
      "note": "0-10g"
    },
    {
      "name": "酱油",
      "note": "5ml"
    },
    {
      "name": "食盐",
      "note": "3g"
    },
    {
      "name": "鸡精",
      "note": "0-3g"
    }
  ],
  "steps": [
    {
      "text": "水煮沸，并加入碱水面，焯烫 25 秒钟捞起"
    },
    {
      "text": "撒上食盐、鸡精和胡椒粉"
    },
    {
      "text": "芝麻酱用 90ml 水稀释，搅匀，然后加入"
    },
    {
      "text": "加入 5ml 酱油，加入 30ml 肉汤汁和蒜水"
    },
    {
      "text": "加入萝卜干，肉末，酸豆角，葱花"
    },
    {
      "text": "拌均匀后开吃"
    }
  ],
  "tips": [
    "辣椒油看个人口味添加"
  ],
