{
  "id": "he-nan-zheng-mian-tiao",
  "name": "河南蒸面条",
  "category": "主食",
  "tags": [
    "重口"
  ],
  "summary": "河南蒸面条是源自河南的家常小吃，面条先蒸后炒再蒸，油润入味，口感劲道爽滑。五花肉和蒜薹提供丰富的蛋白质和膳食纤维，搭配主食带来均衡营养。制作步骤稍多一些，但对新手而言只要按顺序操作就能成功。从备料到出锅，总共约需 40 分钟。",
  "difficulty": 3,
  "servings": 1,
  "cookMinutes": 40,
  "ingredients": [
    {
      "name": "挂面",
      "amount": 300,
      "unit": "g"
    },
    {
      "name": "五花肉",
      "amount": 350,
      "unit": "g"
    },
    {
      "name": "蒜薹",
      "amount": 150,
      "unit": "g"
    },
    {
      "name": "食用油",
      "amount": "10-15",
      "unit": "ml"
    },
    {
      "name": "生抽",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "老抽",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "蚝油",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "盐",
      "amount": 2,
      "unit": "g"
    },
    {
      "name": "鸡精",
      "amount": 2,
      "unit": "g"
    },
    {
      "name": "十三香",
      "amount": 1,
      "unit": "g"
    },
    {
      "name": "葱",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "姜",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "蒜",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "料酒",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "麻油",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "油 + 锅 + 菜刀 + 铲子"
    },
    {
      "name": "蒸篦子"
    },
    {
      "name": "额外的盆"
    }
  ],
  "steps": [
    {
      "text": "### 第一次蒸"
    },
    {
      "text": "起锅加 7 成水，水开，上蒸篦子"
    },
    {
      "text": "将挂面，均匀铺开放置，淋 5ml 油并抹匀，蒸 15 分钟",
      "minutes": 15
    },
    {
      "text": "将挂面和蒸篦子取出，放置一边，并倒掉锅中的水 ### 切菜"
    },
    {
      "text": "五花肉，切成 2mm 厚度的肉片"
    },
    {
      "text": "蒜薹，切成 3cm 段"
    },
    {
      "text": "葱，切成 0.2cm 薄片"
    },
    {
      "text": "姜，切成 1mm x 1mm x 3cm 的细丝"
    },
    {
      "text": "蒜，放在砧板上拍碎，切成 1mm 的粒度 ### 炒制"
    },
    {
      "text": "起锅，烧干水分，加 3ml 食用油"
    },
    {
      "text": "手持锅柄，摇晃锅，使食用油充分挂满锅的 2/3"
    },
    {
      "text": "中火，加入肉片，翻炒 1 分钟",
      "minutes": 1,
      "heat": "中火"
    },
    {
      "text": "加入葱姜蒜，料酒，继续翻炒 1 分钟",
      "minutes": 1
    },
    {
      "text": "将蒜薹段，放入锅中，翻炒 1 分钟",
      "minutes": 1
    },
    {
      "text": "开始调味，加入老抽、生抽、蚝油、盐、鸡精、十三香，翻炒 1 分钟",
      "minutes": 1
    },
    {
      "text": "加入 500ML 水，没过蔬菜，炖煮 1 分钟",
      "minutes": 1
    },
    {
      "text": "将蒸好的挂面放入，不断搅拌 3 分钟，待挂面全部均匀上色，关火",
      "minutes": 3
    },
    {
      "text": "将搅拌好的挂面和菜，全部倒入额外的盆中 ### 第二次蒸"
    },
    {
      "text": "起锅，加冷水 7 成，放上蒸篦子，将拌好的面条和菜，均匀的铺在上面"
    },
    {
      "text": "水开后，大火烧 15 分钟，出锅",
      "minutes": 15,
      "heat": "大火"
    },
    {
      "text": "淋上 10g 的麻油，即可食用"
    }
  ],
  "tips": [
    "细的、圆的 （超市大部分都是这种，口感更加劲道）",
    "宽的、扁的 （口感比较软）"
  ],
