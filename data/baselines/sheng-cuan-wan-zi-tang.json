{
  "id": "sheng-cuan-wan-zi-tang",
  "name": "生汆丸子汤",
  "category": "汤羹",
  "tags": [
    "清淡",
    "一锅出"
  ],
  "summary": "生汆丸子汤口感鲜嫩弹滑，是一道原汁原味的家常汤品。猪肉提供优质蛋白质，搭配木耳、黄花等食材，营养较为均衡。制作中需要自己剁肉并掌握挤丸子的火候，稍有些门槛，更适合有一定基础的厨艺爱好者。从备料到上桌大约需要 1 小时。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "盐量 = 猪肉斤数 *",
      "amount": 6,
      "unit": "克"
    },
    {
      "name": "胡椒粉量 = 猪肉斤数 *",
      "amount": 2,
      "unit": "克"
    },
    {
      "name": "土豆淀粉 = 多少人的用量 *",
      "amount": 40,
      "unit": "克，本教程以一人用量算"
    },
    {
      "name": "前腿肉",
      "group": "丸子肉配料"
    },
    {
      "name": "葱姜花椒水",
      "group": "丸子肉配料"
    },
    {
      "name": "一个鸡蛋的鸡蛋清",
      "group": "丸子肉配料"
    },
    {
      "name": "熟豆油",
      "group": "丸子肉配料"
    },
    {
      "name": "木耳",
      "group": "丸子汤配料"
    },
    {
      "name": "黄花",
      "group": "丸子汤配料"
    },
    {
      "name": "小香葱",
      "group": "丸子汤配料"
    },
    {
      "name": "泡好的粉丝",
      "group": "丸子汤配料",
      "note": "放碗底"
    },
    {
      "name": "鸡粉",
      "group": "丸子汤配料"
    },
    {
      "name": "香油",
      "group": "丸子汤配料"
    },
    {
      "name": "香菜",
      "group": "丸子汤配料"
    }
  ],
  "steps": [
    {
      "text": "### 剁肉"
    },
    {
      "text": "肉改刀切开，肥瘦三七分"
    },
    {
      "text": "上刀剁一剁，用刀背砸一砸，把肉筋打开打松疏"
    },
    {
      "text": "剁一剁，砸一砸，剁成肉末，要想好吃得自己剁，机器打的太黏糊了 ### 调味"
    },
    {
      "text": "每斤肉，6 克盐，1 克胡椒粉"
    },
    {
      "text": "上手抓匀"
    },
    {
      "text": "葱姜花椒水分次加，边加边搅，用手揉匀，让肉吸饱水。每斤肉末 80 克葱姜花椒水"
    },
    {
      "text": "放入鸡蛋清，继续顺着一个方向搅"
    },
    {
      "text": "加入 40 克土豆淀粉，搅匀"
    },
    {
      "text": "加入熟豆油，这是为了保持其嫩滑弹的状态 ### 汆丸子"
    },
    {
      "text": "起锅烧水，烧开，改小火，似开非开的样子",
      "heat": "小火"
    },
    {
      "text": "上手，挤丸子，"
    },
    {
      "text": "全部漂起来，用小火煮 1 分钟 ### 制作丸子汤",
      "minutes": 1,
      "heat": "小火"
    },
    {
      "text": "粉丝放碗底"
    },
    {
      "text": "加木耳，黄花，小香葱并用盐、胡椒粉、鸡粉打底调味"
    },
    {
      "text": "连汤带丸子冲如碗中"
    },
    {
      "text": "淋 3-5 滴香油"
    },
    {
      "text": "加一小颗香菜"
    }
  ],
  "tips": [
    "辣椒油可以根据口味放"
  ],
