{
  "id": "ma-yi-shang-shu",
  "name": "蚂蚁上树",
  "category": "家常菜",
  "tags": [
    "辣",
    "下饭"
  ],
  "summary": "蚂蚁上树是一道经典的川味家常菜，咸香微辣，粉丝软滑吸汁，肉末细嫩鲜香。以红薯粉丝和肉末为主料，富含碳水化合物与蛋白质，能快速补充能量。制作难度中等，步骤清晰，对新手比较友好，全程约需 20 分钟即可完成。",
  "difficulty": 2,
  "servings": 2,
  "cookMinutes": 20,
  "ingredients": [
    {
      "name": "红薯粉丝",
      "amount": 80,
      "unit": "g",
      "note": "干重"
    },
    {
      "name": "猪肉末",
      "amount": 150,
      "unit": "g"
    },
    {
      "name": "郫县豆瓣酱",
      "amount": 15,
      "unit": "g"
    },
    {
      "name": "生抽",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "老抽",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "食用油",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "蒜末",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "姜末",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "清水",
      "amount": 300,
      "unit": "ml",
      "note": "用于煮粉丝"
    },
    {
      "name": "小葱",
      "note": "可选"
    }
  ],
  "steps": [
    {
      "text": "红薯粉丝提前泡软，泡水时间为 20 分钟，备用",
      "minutes": 20
    },
    {
      "text": "将蒜、姜分别剁碎，备用"
    },
    {
      "text": "锅烧热，加入 10ml 食用油，加入蒜末、姜末炒香"
    },
    {
      "text": "加入猪肉末翻炒至**肉色发白且微微出油**"
    },
    {
      "text": "加入郫县豆瓣酱，炒至**红油析出**"
    },
    {
      "text": "加入生抽和老抽，翻炒均匀"
    },
    {
      "text": "倒入 300ml 清水，煮沸"
    },
    {
      "text": "放入泡软沥干的粉丝，用筷子轻轻拨动防止粘连"
    },
    {
      "text": "中小火煮约 5 分钟，直至粉丝**完全吸收汤汁**、呈现微微收干状态",
      "minutes": 5,
      "heat": "中小火"
    },
    {
      "text": "依据口味可撒入小葱末，关火装盘"
    }
  ],
  "tips": [
    "粉丝不建议煮太久，易断且口感变差；若时间过长汤汁应适当减少",
    "郫县豆瓣酱含盐量较高，可根据口味酌情减少生抽用量",
    "可加入 0.5g 白胡椒粉调味，风味更佳"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
