{
  "id": "su-chao-dou-jiao",
  "name": "素炒豆角",
  "category": "家常菜",
  "tags": [
    "下饭",
    "辣",
    "新手友好"
  ],
  "summary": "这是一道酱香浓郁的家常小炒，豆角软嫩入味，鲜辣下饭。富含膳食纤维和多种维生素，有助于促进消化。做法简单，新手也能轻松上手，从备菜到出锅大约 20 分钟。",
  "difficulty": 1,
  "servings": 2,
  "cookMinutes": 20,
  "ingredients": [
    {
      "name": "豆角",
      "amount": 250,
      "unit": "g"
    },
    {
      "name": "小米椒",
      "amount": 2,
      "unit": "个"
    },
    {
      "name": "葱",
      "amount": 3,
      "unit": "圈"
    },
    {
      "name": "蒜",
      "amount": 2,
      "unit": "颗"
    },
    {
      "name": "生抽",
      "amount": 6,
      "unit": "ml"
    },
    {
      "name": "老抽",
      "amount": 2,
      "unit": "ml"
    },
    {
      "name": "耗油",
      "amount": 6,
      "unit": "ml"
    },
    {
      "name": "盐",
      "amount": 6,
      "unit": "g"
    }
  ],
  "steps": [
    {
      "text": "葱切花，蒜切沫，备用。"
    },
    {
      "text": "生抽、老抽、耗油、盐混合调料汁，备用。"
    },
    {
      "text": "小米椒切圈，备用。"
    },
    {
      "text": "豆角去筋，45° 斜切*4-10cm*小段，备用。"
    },
    {
      "text": "起锅烧油(10ml - 15ml)，冒烟后放入葱、小米椒，翻炒至闻到香味；"
    },
    {
      "text": "加入豆角，翻炒*30s*,"
    },
    {
      "text": "加入料汁，开大火翻炒*2分钟*",
      "minutes": 2,
      "heat": "大火"
    },
    {
      "text": "倒入 150ml 水"
    },
    {
      "text": "转中小火，盖上锅盖焖制 8-10 分钟",
      "minutes": 8,
      "heat": "中小火"
    },
    {
      "text": "加入蒜切沫，出锅。"
    }
  ],
  "tips": [
    "切豆角需要一定的刀工，不会的可以使用剪刀"
  ],
