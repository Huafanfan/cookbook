{
  "id": "liang-ban-dou-fu",
  "name": "凉拌豆腐",
  "category": "家常菜",
  "summary": "这道凉菜清爽可口，富含植物蛋白和钙质，低脂健康，制作简单快捷，一般初学者只需要 10 分钟即可完成。",
  "difficulty": 1,
  "servings": 1,
  "cookMinutes": 10,
  "ingredients": [
    {
      "name": "豆腐",
      "amount": 250,
      "unit": "g",
      "note": "约 1 块常见大小的豆腐"
    },
    {
      "name": "小葱",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "大蒜",
      "amount": "2-3",
      "unit": "瓣"
    },
    {
      "name": "生抽",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "香油",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "醋",
      "amount": 5,
      "unit": "ml",
      "note": "可选"
    },
    {
      "name": "白糖",
      "amount": 2,
      "unit": "g",
      "note": "可选"
    },
    {
      "name": "辣椒油",
      "amount": 5,
      "unit": "ml",
      "note": "可选"
    }
  ],
  "steps": [
    {
      "text": "将 豆腐 切成 2 cm 见方的小块，备用。"
    },
    {
      "text": "锅中加入 500 ml 饮用水，大火烧开。",
      "heat": "大火"
    },
    {
      "text": "放入 豆腐 块，煮 **1-2 分钟**，以去除豆腥味并使豆腐口感更紧实。",
      "minutes": 1
    },
    {
      "text": "将 煮好的 豆腐 块捞出，沥干水分，放入碗中，备用。"
    },
    {
      "text": "将 小葱 洗净，切成葱花，备用。"
    },
    {
      "text": "将 大蒜 去皮，切成蒜末，备用。"
    },
    {
      "text": "在一个干净的小碗中，加入 15 ml 生抽，5 ml 香油，5 ml 醋（可选），2 g 白糖（可选）。"
    },
    {
      "text": "加入切好的 大蒜末。"
    },
    {
      "text": "搅拌均匀，使 白糖 充分溶解，酱汁混合均匀。"
    },
    {
      "text": "将制作好的酱汁均匀淋在 豆腐 块上。"
    },
    {
      "text": "撒上切好的 小葱花。"
    },
    {
      "text": "根据个人喜好，淋上 5 ml 辣椒油（可选）。"
    },
    {
      "text": "用 筷子 或勺子轻轻拌匀，即可食用。"
    }
  ],
  "tips": [
    "制作凉拌豆腐时，建议选用质地较硬的北豆腐或老豆腐，不易碎裂，口感更佳。",
    "如果喜欢更清淡的口感，可以省略醋和辣椒油。",
    "酱汁的比例可以根据个人口味进行调整。"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook",
  "tags": [
    "快手",
    "新手友好",
    "清淡",
    "减脂"
  ]
}
