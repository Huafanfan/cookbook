{
  "id": "xi-hong-shi-chao-ji-dan",
  "name": "西红柿炒鸡蛋",
  "aliases": [
    "番茄炒蛋",
    "西红柿炒蛋",
    "番茄炒鸡蛋"
  ],
  "category": "家常菜",
  "tags": [
    "快手",
    "下饭",
    "新手友好"
  ],
  "summary": "十分钟出锅的国民下饭菜，关键在于鸡蛋炒得嫩、西红柿出汁。",
  "difficulty": 1,
  "servings": 2,
  "prepMinutes": 5,
  "cookMinutes": 7,
  "equipmentAlternatives": [
    [
      "炒锅",
      "平底锅"
    ]
  ],
  "ingredients": [
    {
      "name": "西红柿",
      "amount": 2,
      "unit": "个",
      "group": "主料",
      "note": "选熟透的，去皮口感更好"
    },
    {
      "name": "鸡蛋",
      "amount": 3,
      "unit": "个",
      "group": "主料"
    },
    {
      "name": "小葱",
      "amount": 1,
      "unit": "根",
      "group": "主料",
      "note": "切葱花，出锅前撒"
    },
    {
      "name": "盐",
      "amount": 3,
      "unit": "g",
      "group": "调料",
      "note": "分两次放"
    },
    {
      "name": "白糖",
      "amount": 5,
      "unit": "g",
      "group": "调料",
      "note": "中和酸味"
    },
    {
      "name": "食用油",
      "amount": 20,
      "unit": "ml",
      "group": "调料"
    }
  ],
  "steps": [
    {
      "text": "西红柿去蒂切滚刀块，鸡蛋打散加 1g 盐搅匀。",
      "title": "备料",
      "minutes": 3
    },
    {
      "text": "热锅倒 15ml 油，油温六成热下蛋液，凝固成块即盛出，不要炒老。",
      "title": "炒蛋",
      "heat": "中火",
      "minutes": 2,
      "tip": "蛋液刚凝固就出锅，后面还要回锅。"
    },
    {
      "text": "锅内补 5ml 油，下西红柿中火翻炒出汁，加白糖和剩余 2g 盐。",
      "title": "炒西红柿",
      "heat": "中火",
      "minutes": 3,
      "tip": "西红柿不出汁就加盖焖 1 分钟。"
    },
    {
      "text": "倒回鸡蛋，翻匀让蛋块吸满汤汁，撒葱花出锅。",
      "title": "合炒",
      "heat": "大火",
      "minutes": 1
    }
  ],
  "tips": [
    "鸡蛋分两次放盐：打散时一次定型，炒西红柿时一次调味，咸淡更均匀。",
    "想汤汁多就加 30ml 热水，适合拌饭。",
    "西红柿去皮：顶部划十字，开水烫 10 秒即可轻松撕皮。"
  ],
  "source": "家常做法",
  "createdAt": "2026-09-19",
  "updatedAt": "2026-09-19"
}
