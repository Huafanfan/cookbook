{
  "id": "huang-gua-pi-dan-tang",
  "name": "黄瓜皮蛋汤",
  "category": "汤羹",
  "summary": "黄瓜皮蛋汤是一道快手家常汤品，口味清淡，带着皮蛋与蒜瓣煸炒出的焦香，暖心暖胃且不油腻。黄瓜清热补水，皮蛋提供一定蛋白质，低脂少负担。做法几乎没有技术门槛，厨房新手也能轻松完成，从备料到出锅只需大约十 分钟。",
  "difficulty": 1,
  "servings": 2,
  "ingredients": [
    {
      "name": "黄瓜",
      "amount": 1,
      "unit": "根"
    },
    {
      "name": "皮蛋",
      "amount": 2,
      "unit": "个"
    },
    {
      "name": "大蒜",
      "amount": 2,
      "unit": "瓣"
    },
    {
      "name": "小葱"
    },
    {
      "name": "食用油",
      "amount": "10-15",
      "unit": "g"
    },
    {
      "name": "盐",
      "amount": "2-3",
      "unit": "g"
    },
    {
      "name": "鸡精",
      "amount": "0.5-1",
      "unit": "g"
    },
    {
      "name": "水",
      "amount": "400-500",
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "黄瓜洗净，切成 0.5-1.2 mm 厚的薄片"
    },
    {
      "text": "葱洗净切成末，蒜用刀拍几下去皮，对半切一下"
    },
    {
      "text": "皮蛋剥去壳，然后每个切成 6-8 份。锅里倒入油，放入切好的皮蛋和大蒜"
    },
    {
      "text": "小火炒至皮蛋和大蒜表面有些焦黄，加入水，转大火烧开"
    },
    {
      "text": "放入黄瓜片。水再次沸腾以后立马关火，放入盐、鸡精调味即可出锅"
    },
    {
      "text": "装入碗中，再撒上葱花即可"
    }
  ],
  "tips": [
    "黄瓜可以根据喜好决定是否去皮",
    "黄瓜薄片可以用刮皮刀刮",
    "皮蛋切块时抹点香油不容易粘刀",
    "参考资料：[【黄瓜皮蛋汤的做法步骤图，黄瓜皮蛋汤怎么做好吃】是春天呐__下厨房](https://www.xiachufang.com/recipe/103991291/)"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook",
  "tags": [
    "快手",
    "清淡",
    "一锅出"
  ]
}
