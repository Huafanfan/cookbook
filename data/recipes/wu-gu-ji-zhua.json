      "amount": 10,
      "unit": "瓣"
    },
    {
      "name": "小米辣",
      "amount": 4,
      "unit": "个少辣，6",
      "note": "个中辣，12 个大辣；推荐大辣"
    },
    {
      "name": "洋葱",
      "note": "半个"
    },
    {
      "name": "生抽",
