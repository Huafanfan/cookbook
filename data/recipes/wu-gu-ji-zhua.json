      "amount": 4,
      "unit": "片"
    },
    {
      "name": "料酒",
      "amount": 65,
      "unit": "g"
    },
    {
      "name": "大葱",
      "amount": 3,
      "unit": "段",
      "note": "5cm 一段"
    },
    {
