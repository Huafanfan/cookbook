      "amount": 50,
      "unit": "g",
      "note": "推荐陈醋"
    },
    {
      "name": "白糖",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "盐",
      "amount": 3,
      "unit": "g"
    },
    {
      "name": "花椒油",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "香菜",
      "amount": 3,
      "unit": "颗"
    },
    {
      "name": "柠檬",
      "amount": 2,
      "unit": "颗",
      "note": "以 1 颗为单位来调整酸度"
    }
