{
  "id": "leng-chi-tu",
  "name": "冷吃兔",
  "category": "家常菜",
  "tags": [
    "辣",
    "重口"
  ],
  "summary": "这是一道经典的四川自贡盐帮菜，麻辣干香，兔肉紧实有嚼劲，入口先辣后鲜，回味悠长。兔肉高蛋白低脂肪，富含卵磷脂和多种氨基酸，营养丰富且易于消化。制作过程需处理多种香料并严格控制火候，对新手有一定挑战。从备料到炒制完成约需 1.5 小时，但放置一夜后风味更佳，值得提前准备。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "盐量 = 兔肉斤数 *",
      "amount": 2,
      "unit": "克"
    },
    {
      "name": "味精量 = 兔肉斤数 *",
      "amount": 1,
      "unit": "克"
    },
    {
      "name": "蚝油量 = 兔肉斤数 *",
      "amount": 5,
      "unit": "克"
    },
    {
      "name": "料酒量 = 兔肉斤数 *",
      "amount": 10,
      "unit": "克"
    },
    {
      "name": "油量 = 兔肉斤数 *",
      "amount": 0.9,
      "unit": "～",
      "note": "1 升"
    },
    {
      "name": "蒜量 = 兔肉斤数 *",
      "amount": "二",
      "unit": "分之一头蒜"
    },
    {
      "name": "姜量 = 蒜量"
    },
    {
      "name": "小葱/大葱/洋葱总量 = 兔肉斤数 *",
      "amount": 15,
      "unit": "克"
    },
    {
      "name": "干辣椒量 = 辣椒段的总体积等于兔肉的总体积"
    },
    {
      "name": "青花椒量",
      "amount": 3,
      "unit": "斤兔肉对应吃饭用的小碗，一整碗花椒"
    },
    {
      "name": "八角量 = 兔肉斤数 *",
      "amount": 1,
      "unit": "粒"
    },
    {
      "name": "桂皮量 = 兔肉斤数 * 大拇指长短的一块"
    },
    {
      "name": "香叶量 = 兔肉斤数 *",
      "amount": 5,
      "unit": "片"
    },
    {
      "name": "山奈量 = 兔肉斤数 * 黄豆大小的一块"
    },
    {
      "name": "白蔻量 = 兔肉斤数 *",
      "amount": 2,
      "unit": "颗"
    },
    {
      "name": "小茴香量 = 兔肉斤数 *",
      "amount": 15,
      "unit": "克"
    },
    {
      "name": "白芝麻量 = 兔肉斤数 *",
      "amount": 25,
      "unit": "克"
    }
  ],
  "steps": [
    {
      "text": "蒜、姜扒皮并剁碎备用，八角、桂皮、香叶、山奈、白蔻、小茴香洗净备用。"
    },
    {
      "text": "干辣椒剪成 2 厘米的小段，洗净备用。"
    },
    {
      "text": "小葱/大葱/洋葱洗净，洋葱切成小块。"
    },
    {
      "text": "兔肉剁成 2 厘米的小块，加入盐、料酒、味精调味，腌制 15 分钟。",
      "minutes": 15
    },
    {
      "text": "锅中倒油，油温 4 成热下小葱/大葱/洋葱，中小火煸炒出香味，待到小葱/大葱/洋葱微焦，将其捞出。",
      "heat": "中小火"
    },
    {
      "text": "开大火升高油温，油温 8 成热时下入兔肉，炸制过程转中小火，炸至兔肉微微焦黄时捞出兔肉。"
    },
    {
      "text": "升高油温，倒入干辣椒、青花椒、八角、桂皮、香叶、山奈、白蔻、小茴香；转小火将辣椒段炸脆。",
      "heat": "小火"
    },
    {
      "text": "重新倒入兔肉，加入蚝油、翻炒几分钟。"
    },
    {
      "text": "关火，加入蒜、姜、白芝麻，翻炒均匀。"
    },
    {
      "text": "放置一夜更加入味。"
    }
  ],
