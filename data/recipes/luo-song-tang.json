{
  "id": "luo-song-tang",
  "name": "罗宋汤",
  "category": "汤羹",
  "tags": [
    "酸甜",
    "一锅出"
  ],
  "summary": "一道源自俄罗斯甜菜汤、在上海改良的海派家常汤品，以番茄和牛肉为主调，口感酸甜浓郁、醇厚鲜美。富含优质蛋白、番茄红素及多种维生素，营养均衡。制作简单，对初学者友好，全程预计 2–3 小时即可完成。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "牛肉高汤",
      "amount": 500,
      "unit": "mL"
    },
    {
      "name": "牛肉",
      "amount": 250,
      "unit": "g",
      "note": "可选用牛腩肉或牛尾肉"
    },
    {
      "name": "番茄罐头",
      "amount": 2,
      "unit": "罐",
      "note": "可用番茄替代、但风味欠佳"
    },
    {
      "name": "番茄膏",
      "amount": 5,
      "unit": "g",
      "note": "增加番茄风味"
    },
    {
      "name": "马铃薯",
      "amount": 400,
      "unit": "g"
    },
    {
      "name": "洋葱",
      "amount": 100,
      "unit": "g"
    },
    {
      "name": "胡萝卜",
      "amount": 100,
      "unit": "g"
    },
    {
      "name": "欧芹",
      "amount": 100,
      "unit": "g"
    },
    {
      "name": "包菜",
      "amount": 200,
      "unit": "g"
    },
    {
      "name": "红肠",
      "amount": "100-200",
      "unit": "g"
    },
    {
      "name": "橄榄油",
      "amount": 5,
      "unit": "mL",
      "note": "橄榄油用于蔬菜的烹制，可以用植物油代替"
    },
    {
      "name": "植物油",
      "amount": 5,
      "unit": "mL",
      "note": "植物油用于牛肉的烹制，不能用橄榄油代替"
    },
    {
      "name": "盐",
      "amount": 18,
      "unit": "g"
    },
    {
      "name": "黑胡椒",
      "amount": 3,
      "unit": "g"
    },
    {
      "name": "蔬菜高汤",
      "note": "欧芹、胡萝卜、洋葱三件套"
    }
  ],
  "steps": [
    {
      "text": "### 切配准备"
    },
    {
      "text": "洋葱、胡萝卜、欧芹切 1cm 见方小丁"
    },
    {
      "text": "红肠、马铃薯切 2cm 块"
    },
    {
      "text": "包菜去梗后，手撕至 2cm 片"
    },
    {
      "text": "牛肉撒盐 3 g 、黑胡椒 3 g 腌制 5 分钟 ### 煎制过程",
      "minutes": 5
    },
    {
      "text": "平底锅烧热，加入植物油"
    },
    {
      "text": "煎制牛肉，直至表面**焦黄色**（可以带生，千万别糊了），取出备用。 ### 烹制过程1（前一小时）"
    },
    {
      "text": "汤锅烧热，加入橄榄油、洋葱丁、胡萝卜丁、欧芹丁"
    },
    {
      "text": "炒至**洋葱透明**，加入番茄膏、番茄罐头"
    },
    {
      "text": "加入牛肉、马铃薯丁，翻炒均匀"
    },
    {
      "text": "加水没过食材，中火烹制 1 小时 ### 烹制过程2（后半小时）",
      "heat": "中火"
    },
    {
      "text": "开锅加入包菜丁、红肠丁，搅拌均匀"
    },
    {
      "text": "中火烹制半小时",
      "heat": "中火"
    },
    {
      "text": "开盖加入剩余 15 g 盐，混合均匀后盛盘"
    }
  ],
  "tips": [
    "番茄尽量不用新鲜番茄代替，番茄罐头+番茄膏的组合风味更足",
    "除了胡萝卜、洋葱、欧芹、牛肉是必备食材外，其余可自由搭配"
  ],
