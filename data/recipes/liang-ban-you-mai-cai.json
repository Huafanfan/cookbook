{
  "id": "liang-ban-you-mai-cai",
  "name": "凉拌油麦菜",
  "category": "家常菜",
  "summary": "一道清爽解腻的家常凉菜，芝麻酱的醇厚包裹着油麦菜的脆嫩，酸甜咸香交织，非常开胃。油麦菜富含维生素和膳食纤维，芝麻酱则补充钙与健康脂肪，营养均衡。做法毫无难度，切一切、拌一拌就行，从准备到上桌只需十几分钟，特别适合新手和忙碌时快速成菜。",
  "difficulty": 1,
  "servings": 1,
  "ingredients": [
    {
      "name": "1 颗 油麦菜 * 份数",
      "note": "约 200g"
    },
    {
      "name": "15ml 醋 * 份数"
    },
    {
      "name": "5ml 酱油 * 份数"
    },
    {
      "name": "10ml 芝麻酱 * 份数"
    },
    {
      "name": "5ml 香油 * 份数"
    },
    {
      "name": "5g 糖 * 份数"
    },
    {
      "name": "10ml 蚝油 * 份数"
    },
    {
      "name": "两**头**蒜 * 份数"
    },
    {
      "name": "白糖"
    },
    {
      "name": "盐"
    }
  ],
  "steps": [
    {
      "text": "蒜拍碎切末"
    },
    {
      "text": "醋，酱油，芝麻酱，香油，糖，蚝油，蒜末放到碗里搅拌均匀"
    },
    {
      "text": "油麦菜切段，每段不超过 4cm"
    },
    {
      "text": "油麦菜放到一个大点的盆里，倒入上述碗中酱料，充分搅拌均匀."
    }
  ],
  "tips": [
    "芝麻酱可以用花生酱代替",
    "芝麻酱一定要和油麦菜混合均匀才更好吃."
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook",
  "tags": [
    "酸甜",
    "快手"
  ]
}
