{
  "id": "jiu-cai-chao-dan",
  "name": "韭菜炒蛋",
  "category": "家常菜",
  "summary": "韭菜炒蛋是一道经典的家常菜，韭菜香气浓郁，鸡蛋嫩滑鲜美，简单易做，营养丰富。韭菜含有丰富的维生素和纤维素，鸡蛋提供优质蛋白质。这道菜制作简单，原材料易得，特别适合厨房新手入门，从头备菜到盛盘出锅大约只需 10 分钟。",
  "difficulty": 1,
  "servings": 1,
  "cookMinutes": 10,
  "ingredients": [
    {
      "name": "韭菜",
      "amount": 100,
      "unit": "g",
      "note": "份数"
    },
    {
      "name": "鸡蛋",
      "amount": 2,
      "unit": "个",
      "note": "份数"
    },
    {
      "name": "食用油",
      "amount": 10,
      "unit": "ml",
      "note": "份数"
    },
    {
      "name": "盐",
      "amount": 2,
      "unit": "g",
      "note": "份数"
    }
  ],
  "steps": [
    {
      "text": "韭菜洗净，沥干水分"
    },
    {
      "text": "韭菜切成约 3cm 长的小段，即为 `韭菜段`"
    },
    {
      "text": "将鸡蛋打入碗中，搅匀，即为 `鸡蛋液`"
    },
    {
      "text": "热锅，加入食用油"
    },
    {
      "text": "油热后，倒入 `鸡蛋液`，快速翻炒至鸡蛋凝固成块，盛出备用，即为 `炒好的鸡蛋`"
    },
    {
      "text": "锅中再加 5ml 食用油，放入 `韭菜段`，大火快速翻炒 30 秒",
      "heat": "大火"
    },
    {
      "text": "向锅中加入 `炒好的鸡蛋`，翻炒均匀"
    },
    {
      "text": "加入盐，翻炒均匀"
    },
    {
      "text": "关火，盛盘"
    }
  ],
  "tips": [
    "韭菜炒蛋讲究大火快炒，韭菜炒久了容易失去香气和脆嫩口感",
    "如果喜欢韭菜更软烂，可以适当延长翻炒时间"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
