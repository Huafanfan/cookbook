{
  "id": "suan-la-tu-dou-si",
  "name": "酸辣土豆丝",
  "category": "家常菜",
  "summary": "酸辣开胃的经典家常菜，口感脆爽，色泽鲜亮，属于大众喜爱的快手小炒。土豆提供碳水化合物和钾元素，辣椒富含维生素 C，有助于增进食欲。操作步骤简单明了，对新手十分友好，从备料到出锅大约只需 20 分钟。",
  "difficulty": 1,
  "servings": 2,
  "cookMinutes": 20,
  "ingredients": [
    {
      "name": "土豆",
      "amount": 240,
      "unit": "g",
      "note": "越细越长更好"
    },
    {
      "name": "大蒜",
      "amount": 4,
      "unit": "瓣"
    },
    {
      "name": "青椒",
      "amount": 0.5,
      "unit": "个"
    },
    {
      "name": "红椒",
      "amount": 0.5,
      "unit": "个"
    },
    {
      "name": "干辣椒",
      "amount": 3,
      "unit": "个"
    },
    {
      "name": "葱",
      "amount": 1,
      "unit": "根"
    },
    {
      "name": "生抽",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "陈醋",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "盐",
      "amount": 2,
      "unit": "g"
    },
    {
      "name": "食用油",
      "amount": "10-15",
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "土豆去皮、切丝（或用刨丝器）。"
    },
    {
      "text": "切好的土豆丝用清水清洗，去除多余的淀粉，然后对土豆丝焯水 10 秒。沥干，备用。"
    },
    {
      "text": "葱切成葱花；大蒜拍碎切成蒜末（分为两等份备用）；干辣椒切小段；青红椒切丝。"
    },
    {
      "text": "热锅，小火热油，下入一半的葱花（葱白部分）、一半的蒜末和干辣椒爆香。",
      "heat": "小火"
    },
    {
      "text": "加入青红椒翻炒几下，加入土豆丝翻炒至变色。"
    },
    {
      "text": "加 5ml 生抽，10ml 陈醋，倒入剩下的一半蒜末和 2g 盐快速翻炒均匀。"
    },
    {
      "text": "出锅前撒上剩余的葱花，翻匀即可装盘。"
    }
  ],
  "tips": [
    "清洗土豆丝淀粉一定要去干净，不然会全黏在一起",
    "加入蒜末、盐后应尽快出锅，保留蒜香以及避免破坏口感。"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook · 原文未声明份量，按官方模板约定记为 2 人份",
  "tags": [
    "辣",
    "快手"
  ]
}
