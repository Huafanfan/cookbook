{
  "id": "lao-gan-ma-ban-mian",
  "name": "老干妈拌面",
  "category": "主食",
  "summary": "一道香辣开胃的家常快手面食，面条筋道裹满老干妈的豆豉辣香，酱油提鲜，简单却滋味十足。作为主食能快速补充碳水化合物和能量，辣椒素还有助促进食欲。制作毫无门槛，新手也能轻松驾驭，从烧水到出锅只需大约十 分钟。",
  "difficulty": 1,
  "servings": 1,
  "ingredients": [
    {
      "name": "水",
      "amount": 1,
      "unit": "升"
    },
    {
      "name": "面量",
      "amount": 120,
      "unit": "克",
      "note": "份数"
    },
    {
      "name": "老干妈",
      "amount": 15,
      "unit": "ml",
      "note": "份数"
    },
    {
      "name": "酱油",
      "amount": 5,
      "unit": "ml",
      "note": "份数"
    }
  ],
  "steps": [
    {
      "text": "将水倒入锅中并煮沸"
    },
    {
      "text": "将面均匀放入锅中"
    },
    {
      "text": "在煮的过程注意搅拌，避免面粘成一坨"
    },
    {
      "text": "当用筷子挑起一根面且该面能自然地从筷子上滑落时再等 30 秒关火"
    },
    {
      "text": "将面夹入碗中"
    },
    {
      "text": "按照上面的计量放入老干妈和酱油"
    },
    {
      "text": "用筷子将碗里的面、老干妈、酱油拌均匀"
    },
    {
      "text": "吃"
    }
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook",
  "tags": [
    "快手",
    "辣",
    "省事"
  ]
}
