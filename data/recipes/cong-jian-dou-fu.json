{
  "id": "cong-jian-dou-fu",
  "name": "葱煎豆腐",
  "category": "家常菜",
  "summary": "外焦里嫩，葱香浓郁，咸鲜微辣，是一道家常风味。豆腐富含植物蛋白和钙质，搭配青椒和葱段，营养均衡。制作难度适中，煎豆腐时需掌握小火慢煎，新手按步骤耐心操作也能做好，全程约 30 分钟。",
  "difficulty": 2,
  "servings": 1,
  "cookMinutes": 30,
  "equipment": [
    "平底锅"
  ],
  "ingredients": [
    {
      "name": "白豆腐的数量 = 份数 *",
      "amount": 0.8,
      "unit": "向上取整。"
    },
    {
      "name": "辣椒的数量",
      "amount": 1.5,
      "unit": "只/三人。"
    },
    {
      "name": "葱的数量",
      "amount": 2,
      "unit": "根/三人。"
    },
    {
      "name": "盐量 = 份数 *",
      "amount": 3,
      "unit": "g。"
    },
    {
      "name": "鸡精量 = 份数 *",
      "amount": 1.5,
      "unit": "g。"
    },
    {
      "name": "青辣椒"
    }
  ],
  "steps": [
    {
      "text": "豆腐洗净。切约 5 mm 厚度，置于碟中。"
    },
    {
      "text": "葱洗净，除去根部，切成葱花，备用。"
    },
    {
      "text": "辣椒洗净，切开，去籽，切成 1cm * 1cm 状，备用、"
    },
    {
      "text": "热锅，加入份数 * 9ml 油。"
    },
    {
      "text": "油入锅后，使其均匀布于锅底，均匀放入豆腐，小火煎至金黄翻面。",
      "heat": "小火"
    },
    {
      "text": "待两面金黄，盛入碟中备用。"
    },
    {
      "text": "补油至覆盖锅底，倒入辣椒大火翻炒，并铲碾 3 分钟。",
      "minutes": 3,
      "heat": "大火"
    },
    {
      "text": "倒入豆腐，翻炒，加入盐与鸡精，中火翻炒 1 分钟后倒入 10 ML 水，大火收汁。",
      "minutes": 1
    },
    {
      "text": "出锅前撒上之前计算好的葱花，起锅盛盘。"
    }
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
