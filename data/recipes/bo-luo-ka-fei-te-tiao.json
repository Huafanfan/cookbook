{
  "id": "bo-luo-ka-fei-te-tiao",
  "name": "菠萝咖啡特调",
  "category": "饮品",
  "tags": [
    "快手",
    "酸甜"
  ],
  "summary": "这道特调饮品融合了咖啡的醇香与菠萝的酸甜，气泡清爽、奶盖绵密，口感层次丰富。菠萝富含维生素 C 和膳食纤维，搭配咖啡能提神醒脑。制作难度中等，只需打发奶油并混合液体，全程约 10 分钟即可完成。",
  "difficulty": 2,
  "servings": 1,
  "cookMinutes": 10,
  "ingredients": [
    {
      "name": "咖啡液",
      "amount": 30,
      "unit": "ml"
    },
    {
      "name": "菠萝汁",
      "amount": 60,
      "unit": "ml"
    },
    {
      "name": "冰块",
      "amount": 50,
      "unit": "g"
    },
    {
      "name": "苏打水",
      "amount": 30,
      "unit": "ml"
    },
    {
      "name": "奶油",
      "amount": 30,
      "unit": "ml"
    },
    {
      "name": "牛奶",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "糖",
      "amount": 8,
      "unit": "g"
    },
    {
      "name": "海盐",
      "amount": 0.5,
      "unit": "g"
    },
    {
      "name": "朗姆酒",
      "amount": 5,
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "杯子里依次加入冰块，咖啡液，菠萝汁和苏打水"
    },
    {
      "text": "奶油加糖打发至湿性发泡，加入朗姆酒和牛奶均匀只有流动性"
    },
    {
      "text": "在第一部混合液上方倒入奶油"
    },
    {
      "text": "奶油顶面撒上海盐"
    }
  ],
  "tips": [
    "咖啡液建议选用花果风味，浓缩可以用中烘豆，冷萃可以用普通水洗或者日晒",
    "倒入奶油时，高度尽量放低，让奶油能均匀漂浮在饮料表面形成奶盖",
    "用新鲜的咖啡液和菠萝汁能大大提升整体风味口感"
  ],
