{
  "id": "huo-tui-fan-tuan",
  "name": "火腿饭团",
  "category": "主食",
  "summary": "一道简单快手的日式风味饭团，咸香火腿搭配沙拉酱与海苔，口感丰富饱腹。富含碳水化合物、蛋白质和维生素，能快速补充能量。制作难度极低，新手也能轻松上手，从煮饭到完成大约只需 1 小时。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "火腿",
      "note": "100g"
    },
    {
      "name": "米饭",
      "note": "125g"
    },
    {
      "name": "水",
      "note": "90ml"
    },
    {
      "name": "冷冻青豆",
      "note": "30g"
    },
    {
      "name": "冷冻玉米粒",
      "note": "30g"
    },
    {
      "name": "海苔碎",
      "note": "10g"
    },
    {
      "name": "喜欢的沙拉酱",
      "note": "20g"
    },
    {
      "name": "食用油",
      "amount": "10-15",
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "将米饭和水放到电饭锅里，点击米饭模式，等待完成"
    },
    {
      "text": "冷冻玉米粒和青豆放到锅里，加水没过所有食材，沸腾后静待 2 分钟后，捞出。",
      "minutes": 2
    },
    {
      "text": "火腿切成 1cm 的方块"
    },
    {
      "text": "与此同时，加入 10ml 食用油，加入火腿翻炒至火腿上色"
    },
    {
      "text": "将米饭，火腿，海苔碎，青豆，玉米粒，沙拉酱放入碗中，混合均匀即可"
    },
    {
      "text": "装盘（如果有的话）"
    }
  ],
  "tips": [
    "沙拉酱的程度可以根据个人口味酌情删减。",
    "可以尝试混合沙拉酱。",
    "参考资料：小红书 - 干饭选手又困了"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook",
  "tags": [
    "快手",
    "便当"
  ]
}
