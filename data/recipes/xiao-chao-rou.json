{
  "id": "xiao-chao-rou",
  "name": "小炒肉",
  "category": "家常菜",
  "summary": "小炒肉是一道香辣下饭的经典湘式家常菜，五花肉片焦香不腻，搭配鲜辣椒与豆豉、豆瓣酱炒出浓郁酱香。富含优质蛋白质和脂肪，辣椒能提供丰富的维生素 C，有助开胃暖身。制作难度中等，适合有一定基础的新手尝试，需注意肉片腌制和火候把控。从备料到出锅大约需要 1 小时，其中腌制 30 分钟，炒制过程约 15 分钟。",
  "difficulty": 2,
  "servings": 2,
  "ingredients": [
    {
      "name": "五花肉",
      "amount": 500,
      "unit": "g"
    },
    {
      "name": "朝天椒",
      "amount": 4,
      "unit": "条"
    },
    {
      "name": "小米椒",
      "amount": 4,
      "unit": "颗"
    },
    {
      "name": "豆豉",
      "amount": 10,
      "unit": "g，根据个人口味加减",
      "note": "±5g"
    },
    {
      "name": "豆瓣酱",
      "amount": 10,
      "unit": "g，根据个人口味加减",
      "note": "±5g"
    },
    {
      "name": "老抽",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "淀粉",
      "amount": 10,
      "unit": "g"
    },
    {
      "name": "盐",
      "amount": "1-2",
      "unit": "g"
    },
    {
      "name": "葱",
      "amount": "0.5-1",
      "unit": "根"
    },
    {
      "name": "蒜",
      "amount": 2,
      "unit": "瓣"
    },
    {
      "name": "食用油",
      "amount": 15,
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "五花肉切片"
    },
    {
      "text": "把肉放入器皿内，加入淀粉、老抽、盐搅拌腌制半小时"
    },
    {
      "text": "葱切段"
    },
    {
      "text": "小米椒、朝天椒斜刀切好"
    },
    {
      "text": "热锅、倒油"
    },
    {
      "text": "油热后加入五花肉煸炒。炒至变色后盛出来"
    },
    {
      "text": "向锅中加蒜，煸出香味，加入豆豉，翻炒均匀"
    },
    {
      "text": "加入豆瓣酱翻炒均匀"
    },
    {
      "text": "加入炒好的五花肉继续的翻炒均匀"
    },
    {
      "text": "加入小米椒、朝天椒、葱段翻炒 40 秒"
    },
    {
      "text": "出锅。"
    }
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook · 原文未声明份量，按官方模板约定记为 2 人份"
}
