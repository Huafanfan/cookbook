{
  "id": "fan-qie-niu-rou-dan-hua-tang",
  "name": "番茄牛肉蛋花汤",
  "category": "汤羹",
  "tags": [
    "快手",
    "酸甜"
  ],
  "summary": "番茄牛肉蛋花汤是一道酸甜开胃的家常汤品，口感鲜嫩顺滑。牛肉富含优质蛋白和铁，番茄提供番茄红素和维生素 C，鸡蛋则补充卵磷脂。做法简单，新手也能轻松掌握，通常大约半 小时就能端上餐桌。",
  "difficulty": 2,
  "servings": 2,
  "ingredients": [
    {
      "name": "牛肉用量为",
      "amount": 150,
      "unit": "g/人"
    },
    {
      "name": "番茄用量为",
      "amount": 1,
      "unit": "个/人"
    },
    {
      "name": "鸡蛋用量为",
      "amount": 1,
      "unit": "个/人"
    },
    {
      "name": "盐用量为",
      "amount": 2,
      "unit": "g/人"
    },
    {
      "name": "胡椒粉用量为",
      "amount": 0.5,
      "unit": "g/人"
    },
    {
      "name": "葱、姜、蒜"
    }
  ],
  "steps": [
    {
      "text": "### 配菜处理"
    },
    {
      "text": "牛肉切成薄片"
    },
    {
      "text": "番茄切成小块"
    },
    {
      "text": "葱切成葱花"
    },
    {
      "text": "姜切成姜片"
    },
    {
      "text": "蒜剁成蒜泥 ### 牛肉的预处理"
    },
    {
      "text": "牛肉放入碗中"
    },
    {
      "text": "加盐、胡椒粉腌制 15-20 分钟 ### 煮汤",
      "minutes": 15
    },
    {
      "text": "加水煮开"
    },
    {
      "text": "加入姜片和牛肉片，煮至牛肉变色"
    },
    {
      "text": "加入番茄块，煮至番茄变软"
    },
    {
      "text": "打散鸡蛋液，缓慢地倒入锅中，用筷子搅拌形成蛋花"
    },
    {
      "text": "加入盐和胡椒粉调味"
    },
    {
      "text": "最后加入葱花，即可出锅"
    }
  ],
  "tips": [
    "可以根据口味加入一定的醋或糖来调整口感",
    "如果喜欢辣味，可以加入一定的辣椒或辣椒酱来调味"
  ],
