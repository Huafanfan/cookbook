{
  "id": "jiu-cai-he-zi",
  "name": "韭菜盒子",
  "category": "主食",
  "summary": "韭菜盒子是一道传统中式面点，外皮金黄酥脆，内馅鲜香多汁。韭菜搭配虾仁和鸡蛋，富含维生素与优质蛋白质。做法简单，对新手也很友好，从和面到出锅大约需要 2.5 小时。",
  "difficulty": 2,
  "servings": 2,
  "ingredients": [
    {
      "name": "韭菜",
      "amount": 500,
      "unit": "g"
    },
    {
      "name": "虾仁",
      "amount": 100,
      "unit": "g"
    },
    {
      "name": "鸡蛋",
      "amount": 3,
      "unit": "枚"
    },
    {
      "name": "香油",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "盐",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "面粉",
      "amount": 250,
      "unit": "g"
    }
  ],
  "steps": [
    {
      "text": "将面粉放入大碗中，加入水，搅拌成光滑的面团，静置 30 分钟。",
      "minutes": 30
    },
    {
      "text": "韭菜洗净切碎，加入打散的鸡蛋、5g 盐，搅拌均匀。"
    },
    {
      "text": "将面团分成小剂子，擀成薄圆饼，包入韭菜、虾仁、鸡蛋液。"
    },
    {
      "text": "热锅，加入食用油，放入包好的韭菜盒子，煎至两面金黄，约 3-4 分钟。",
      "minutes": 3
    },
    {
      "text": "盛盘，稍凉后即可享用。"
    }
  ],
  "tips": [
    "制作时可根据个人口味添加豆腐干等配料。",
    "注意煎制时火候，避免外焦内生。"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
