{
  "id": "gu-lu-rou",
  "name": "咕噜肉",
  "category": "家常菜",
  "summary": "咕噜肉是一道经典粤式家常菜，酸甜开胃、外酥里嫩，菠萝的果香让肉块吃起来格外清爽解腻。猪肉提供优质蛋白质，青椒和菠萝则补充维生素与膳食纤维。这道菜的难点在于掌握炸肉的火候，对新手略有挑战，但只要按步骤操作便能成功。从腌制到出锅，全程大约需要 40 分钟，很适合为家人做一道下饭快菜。",
  "difficulty": 3,
  "servings": 2,
  "cookMinutes": 40,
  "ingredients": [
    {
      "name": "1 汤匙",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "1 茶匙",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "梅头猪肉",
      "amount": 100,
      "unit": "g"
    },
    {
      "name": "青椒",
      "amount": 25,
      "unit": "g"
    },
    {
      "name": "罐头菠萝片",
      "amount": 75,
      "unit": "g"
    },
    {
      "name": "盐",
      "amount": 1,
      "unit": "/4",
      "note": "茶匙"
    },
    {
      "name": "茄汁",
      "amount": 4,
      "unit": "汤匙"
    },
    {
      "name": "白醋",
      "amount": 2,
      "unit": "茶匙"
    },
    {
      "name": "蒜蓉",
      "amount": 1,
      "unit": "汤匙"
    },
    {
      "name": "生抽",
      "amount": 1,
      "unit": "/2",
      "note": "茶匙"
    },
    {
      "name": "生粉",
      "amount": 2,
      "unit": "1/2",
      "note": "茶匙"
    },
    {
      "name": "白砂糖",
