  ],
  "steps": [
    {
      "text": "将梅头猪肉（100 克）洗净，然后用厨房纸抹干水份，将猪肉切成比想要的成品小一圈的大小。"
    },
    {
      "text": "用盐（1/2 茶匙）腌制梅头猪肉 20 分钟。",
      "minutes": 20
    },
    {
      "text": "将青椒（25 克）切碎。"
    },
    {
      "text": "将菠萝片（75 克）切件。"
    },
    {
      "text": "在碗中加入茄汁（4 汤匙）﹑白醋（2 茶匙）﹑蒜蓉（1 汤匙）﹑生抽（½ 茶匙）﹑生粉（2½ 茶匙）﹑白砂糖（2 汤匙）﹑盐（¼ 茶匙）和水（200 毫升），拌匀成酱汁。"
    },
    {
      "text": "将梅头猪肉粒沾上生粉（6 汤匙）。"
    },
    {
      "text": "加入油（500 毫升）中火加热。",
      "heat": "中火"
    },
    {
      "text": "将梅头猪肉粒放至锅里中火炸 5 分钟，然后盛起。",
      "minutes": 5,
      "heat": "中火"
    },
    {
      "text": "加入梅头猪肉粒，再大火翻炸 1 分钟。",
      "minutes": 1,
      "heat": "大火"
    },
    {
      "text": "加入油（1 茶匙）和酱汁，中火加热 3 分钟。",
      "minutes": 3,
      "heat": "中火"
    },
    {
      "text": "加入青椒和菠萝，大火加热 2 分钟。",
      "minutes": 2,
      "heat": "大火"
    },
    {
      "text": "将已炸好的梅头猪肉粒与酱汁拌匀即可。"
    }
  ],
  "tips": [
    "想让肉更有层次可以在生粉中加鸡蛋，炸出来会更香脆"
  ],
