{
  "id": "xiao-chao-ou-ding",
  "name": "小炒藕丁",
  "category": "家常菜",
  "summary": "小炒藕丁是一道快手家常素菜，藕丁脆嫩爽口，咸鲜中带着微微辣意，非常下饭。莲藕富含膳食纤维和维生素，有助于清热润燥。制作简单，只要注意藕丁焯水和调味，厨房新手也能轻松完成。全程大约 20 分钟就能端上餐桌。",
  "difficulty": 2,
  "servings": 2,
  "cookMinutes": 20,
  "ingredients": [
    {
      "name": "大葱",
      "amount": 1,
      "unit": "段"
    },
    {
      "name": "小米辣",
      "amount": "1-2",
      "unit": "根",
      "note": "看个人吃辣程度"
    },
    {
      "name": "莲藕",
      "amount": 1,
      "unit": "段"
    },
    {
      "name": "生抽",
      "amount": 30,
      "unit": "ml"
    },
    {
      "name": "老抽",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "耗油",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "食用油",
      "amount": "10-15",
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "大葱、小米辣切小段，备用"
    },
    {
      "text": "莲藕去皮，切成不超过 3cm 的小块，放入水中备用（防止氧化发黑）"
    },
    {
      "text": "取炒锅，锅内放入 500ml 凉水，煮沸"
    },
    {
      "text": "将藕丁下入沸水中，焯水 2 分钟后，取出放入盘中备用",
      "minutes": 2
    },
    {
      "text": "将锅中水倒掉后，将锅加热干燥，加入 10-15 ml 食用油"
    },
    {
      "text": "待油温升高后，下入葱花，小米辣爆香"
    },
    {
      "text": "将处理好的藕丁下入锅中，大火翻炒",
      "heat": "大火"
    },
    {
      "text": "加入生抽、老抽、耗油"
    },
    {
      "text": "翻炒 2 分钟即可出锅",
      "minutes": 2
    }
  ],
  "tips": [
    "食用莲藕要挑选外皮呈黄褐色、肉肥厚而白的。如果发黑，有异味，则不宜食用。",
    "请尽量不要使用铁器，会导致莲藕发黑"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook",
  "tags": [
    "快手",
    "下饭",
    "辣"
  ]
}
