{
  "id": "hei-jiao-niu-liu",
  "name": "黑椒牛柳",
  "category": "家常菜",
  "tags": [
    "下饭",
    "快手"
  ],
  "summary": "黑椒牛柳是一道广受欢迎的家常小炒，黑椒风味浓郁，牛柳嫩滑，搭配甜脆的洋葱和彩椒，荤素均衡，口味老少咸宜。牛肉富含优质蛋白和铁，彩椒和洋葱能补充多种维生素。这道菜对新手十分友好，从备料到出锅，通常一小时以内就能完成。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "牛肉量 = 份数 *",
      "amount": 100,
      "unit": "克",
      "note": "视就餐者胃容量和锅容量酌情增减"
    },
    {
      "name": "洋葱量 = 份数 *",
      "amount": 1,
      "unit": "/12",
      "note": "个；即 3 人时约切 1/4"
    },
    {
      "name": "菜椒量 = 份数 *",
      "amount": 1,
      "unit": "/12",
      "note": "个；即 3 人时约切 1/4"
    },
    {
      "name": "盐量 = 份数 *",
      "amount": 1,
      "unit": "克"
    },
    {
      "name": "淀粉 = 份数 *",
      "amount": 3,
      "unit": "克"
    },
    {
      "name": "黑椒腌料 = 参照所购商品的说明按比例腌制"
    },
    {
      "name": "黑胡椒粉 = 份数 *",
      "amount": 1,
      "unit": "克",
      "note": "实际上是随便撒"
    },
    {
      "name": "花生油 = 份数 *",
      "amount": 10,
      "unit": "ml",
      "note": "实际上油量是依据菜量变动的，如对牛肉的量有增减请按对应比例变动"
    }
  ],
  "steps": [
    {
      "text": "将牛肉切条，长度最好控制在 8 厘米以下，厚度约 5-10 毫米，宽度约 1 厘米（要求不严格）"
    },
    {
      "text": "利用腌料腌制牛肉，混合均匀后静置，用量与时间请参照商品说明，可以延长不能缩短。"
    },
    {
      "text": "如果使用液态腌料，可以在腌制结束前三分钟撒一层黑胡椒粉，然后再加入淀粉，再次混合均匀后静置 20 分钟。",
      "minutes": 20
    },
    {
      "text": "开火，热锅，加入花生油。"
    },
    {
      "text": "当能看到锅里的油冒出一丝烟时，放入牛肉，翻炒。"
    },
    {
      "text": "开中火偏大，翻炒 2 分钟至牛肉外表变色（即不出现明显血色，有血色部分说明翻炒不到位）（此处应小心油滴溅射）。",
      "minutes": 2,
      "heat": "中火"
    },
    {
      "text": "放入洋葱和菜椒，翻炒 2 分钟。",
      "minutes": 2
    },
    {
      "text": "加入盐，再次撒一份黑胡椒粉，翻炒 30 秒，搅拌均匀。"
    },
    {
      "text": "观察洋葱已经变软即可关火，出锅，盛盘。"
    }
  ],
