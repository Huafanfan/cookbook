      "unit": "ml"
    },
    {
      "name": "月桂叶",
      "amount": 2,
      "unit": "片"
    },
    {
      "name": "姜黄粉",
      "amount": 3,
      "unit": "g"
    },
    {
      "name": "红辣椒粉",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "香菜粉",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "孜然粉",
      "amount": 3,
      "unit": "g"
    },
    {
      "name": "印度综合香料粉",
      "amount": 3,
      "unit": "g"
    },
    {
      "name": "盐",
      "amount": 6,
      "unit": "g"
    },
    {
      "name": "水",
      "amount": 600,
      "unit": "ml"
    },
    {
      "name": "香菜叶",
      "amount": 15,
      "unit": "g",
      "note": "装饰用"
    },
    {
      "name": "大米",
      "amount": 200,
      "unit": "g"
    },
    {
      "name": "水",
      "amount": 400,
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "### 准备工作（提前 8 小时）"
    },
    {
      "text": "将干红芸豆用清水浸泡至少 8 小时（过夜），浸泡后体积会膨胀约两倍 ### 煮红芸豆"
    },
    {
      "text": "将浸泡好的红芸豆沥干"
    },
    {
      "text": "放入红芸豆和 600ml 水，盖好锅盖，大火上气后转中火，**压 15-20 分钟**，直至*豆子用手指可轻松压碎*",
      "title": "使用高压锅",
      "minutes": 15
    },
    {
      "text": "放入红芸豆和足量水，大火煮沸后转中火，**煮 60-90 分钟**，直至豆子完全软烂",
      "title": "使用普通锅",
      "minutes": 60
    },
    {
      "text": "煮好后保留煮豆汤水，备用 ### 炒制咖喱"
    },
    {
      "text": "在炒锅中倒入 30ml 食用油，中火加热",
      "heat": "中火"
    },
    {
      "text": "放入月桂叶 2 片，炸至*散出香味*（约 10 秒）"
    },
    {
      "text": "放入切碎的洋葱，翻炒至*金棕色*（约 6-8 分钟）",
      "minutes": 6
    },
    {
      "text": "加入磨碎的生姜和大蒜，翻炒 1 分钟",
      "minutes": 1
    },
    {
      "text": "加入切碎的番茄，翻炒至*番茄完全软烂出油*（约 5 分钟）",
      "minutes": 5
    },
    {
      "text": "加入姜黄粉 3g、红辣椒粉 5g、香菜粉 5g、孜然粉 3g、盐 6g"
    },
    {
      "text": "翻炒 2 分钟，使香料与番茄融合",
      "minutes": 2
    },
    {
      "text": "将煮好的红芸豆连同汤水一起倒入锅中"
    },
    {
      "text": "加入青辣椒，搅拌均匀"
    },
    {
      "text": "大火煮沸后转小火，**炖 15-20 分钟**",
      "minutes": 15
    },
    {
      "text": "期间用铲子背面压碎一部分豆子，使汤汁变得*浓稠*"
    },
    {
      "text": "加入印度综合香料粉 3g，搅拌均匀"
    },
    {
      "text": "关火，撒上香菜叶 ### 蒸米饭"
    },
    {
      "text": "将大米淘洗干净"
    },
    {
      "text": "放入电饭锅，加入 400ml 水"
    },
    {
      "text": "正常蒸煮即可 ### 上菜"
    },
    {
      "text": "将米饭盛入盘中"
    },
    {
      "text": "将红芸豆咖喱浇在米饭上或旁边"
    },
    {
      "text": "可搭配洋葱沙拉和柠檬角"
    }
  ],
  "tips": [
    "红芸豆必须煮熟透才能食用，未熟的红芸豆含有植物血凝素(Phytohaemagglutinin)，可能导致食物中毒。",
    "在印度，Rajma Chawal 被认为是最有家的味道的食物，地位类似于中国的\"红烧肉配米饭\"。",
    "如果想要更浓郁的口感，可以加入 30ml 淡奶油。",
    "剩余的红芸豆咖喱冷藏保存可达 3-4 天，味道会更好。"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
