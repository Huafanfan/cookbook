{
  "id": "zha-chuan-jiang-liao",
  "name": "炸串酱料",
  "category": "调料",
  "summary": "这款万能炸串酱料香辣浓郁、鲜咸适口，属于街头风味风格。主要提供脂肪和香辛料带来的芳香物质，能增进食欲。制作非常简单，对新手毫无压力，全程只需大约 10 分钟即可完成。",
  "difficulty": 1,
  "servings": 2,
  "cookMinutes": 10,
  "ingredients": [
    {
      "name": "干辣椒面",
      "amount": 60,
      "unit": "克"
    },
    {
      "name": "孜然粉",
      "amount": 20,
      "unit": "克"
    },
    {
      "name": "胡椒粉",
      "amount": 10,
      "unit": "克"
    },
    {
      "name": "五香粉",
      "amount": 15,
      "unit": "克"
    },
    {
      "name": "食盐",
      "amount": 20,
      "unit": "克"
    },
    {
      "name": "花椒粉",
      "amount": 15,
      "unit": "克"
    },
    {
      "name": "鸡精",
      "amount": 8,
      "unit": "克"
    },
    {
      "name": "十三香",
      "amount": 5,
      "unit": "克"
    },
    {
      "name": "麻辣鲜",
      "amount": 5,
      "unit": "克"
    },
    {
      "name": "白芝麻",
      "amount": 30,
      "unit": "克"
    }
  ],
  "steps": [
    {
      "text": "所有原料在容器内混合，搅拌均匀。"
    },
    {
      "text": "锅里烧热油，油的用量以在容器内没过所有原材料为佳。"
    },
    {
      "text": "分三次淋入热油，每次 1/3，同时搅拌。"
    },
    {
      "text": "最后放入香油 10ml，生抽 10ml，花椒油 10ml，蚝油 10ml。"
    }
  ],
  "tips": [
    "最后一步的调味可按自己喜好添加。",
    "不得一次性倒入所有热油，必须分次倒入并搅拌。",
    "原料可按比例缩减。"
  ],
