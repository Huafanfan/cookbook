{
  "id": "jiang-cong-lao-ji",
  "name": "姜葱捞鸡",
  "category": "家常菜",
  "tags": [
    "下饭"
  ],
  "summary": "姜葱捞鸡是一道粤式经典家常菜，鸡肉嫩滑多汁，葱姜香气浓郁，咸鲜适口，十分下饭。鸡腿肉提供优质蛋白质，搭配姜葱能温中散寒、促进食欲。整体操作以蒸制和手撕为主，步骤清晰，对新手来说比较容易上手。从备料到完成大约需要 40 分钟。",
  "difficulty": 2,
  "servings": 2,
  "cookMinutes": 40,
  "ingredients": [
    {
      "name": "鸡腿",
      "amount": 4,
      "unit": "个，",
      "note": "约 400g"
    },
    {
      "name": "盐焗鸡粉",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "姜",
      "amount": 50,
      "unit": "g"
    },
    {
      "name": "葱",
      "amount": 1,
      "unit": "根"
    },
    {
      "name": "盐",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "糖",
      "amount": 5,
      "unit": "g"
    },
    {
      "name": "油",
      "amount": 35,
      "unit": "ml"
    }
  ],
  "steps": [
    {
      "text": "四个鸡腿清洗干净，放入碗中"
    },
    {
      "text": "碗中加入盐焗鸡粉和 5ml 油，搅拌均匀"
    },
    {
      "text": "让鸡腿静置腌制 15 分钟， 同时准备蒸锅并把水煮开",
      "minutes": 15
    },
    {
      "text": "鸡腿腌制完成后， 放入水开后的蒸锅中，蒸制 20 分钟",
      "minutes": 20
    },
    {
      "text": "将姜根据个人口味切成 1）姜蓉或 2）姜丝或 3）姜粒"
    },
    {
      "text": "将葱切成 0.5cm 小段"
    },
    {
      "text": "将葱姜放入蘸料碗，并加入盐和糖"
    },
    {
      "text": "将剩余的油倒入另一个锅中加热至六至七层热"
    },
    {
      "text": "将热油淋入葱姜碗中"
    },
    {
      "text": "鸡腿蒸好后将其撕碎成鸡丝，不需要特别细，大概 1cm 粗就可以"
    },
    {
      "text": "姜葱姜油淋在鸡丝上，搅拌均匀即可"
    }
  ],
  "tips": [
    "参考: [白饭杀手来啦 #姜葱捞鸡-哔哩哔哩](https://b23.tv/2trBdqJ)"
  ],
