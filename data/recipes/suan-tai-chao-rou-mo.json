{
  "id": "suan-tai-chao-rou-mo",
  "name": "蒜苔炒肉末",
  "category": "家常菜",
  "tags": [
    "快手",
    "省事"
  ],
  "summary": "蒜苔炒肉末是北方家常菜，咸鲜脆嫩，蒜香浓郁。蒜苔富含膳食纤维和维生素，五花肉提供蛋白质，荤素搭配均衡。做法简单，备料轻松，新手也能快速上手。从切配到出锅大约只需 10 分钟。",
  "difficulty": 1,
  "servings": 2,
  "cookMinutes": 10,
  "ingredients": [
    {
      "name": "蒜苔",
      "amount": 1,
      "unit": "扎",
      "note": "每扎蒜苔约 190g"
    },
    {
      "name": "五花肉薄片",
      "amount": 4,
      "unit": "片",
      "note": "约 20g"
    },
    {
      "name": "食用油",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "蒜瓣",
      "amount": 2,
      "unit": "瓣"
    },
    {
      "name": "生抽",
      "amount": 15,
      "unit": "ml"
    },
    {
      "name": "食盐",
      "amount": 2,
      "unit": "g"
    },
    {
      "name": "食用盐"
    }
  ],
  "steps": [
    {
      "text": "蒜苔切成 5cm 小段，备用"
    },
    {
      "text": "五花肉切成 5mm * 5cm 丝状，备用"
    },
    {
      "text": "蒜瓣拍碎切成末，备用"
    },
    {
      "text": "热锅，锅内放入 10ml 食用油。等待 10 秒让油温升高"
    },
    {
      "text": "放入蒜末，中火翻炒 **10 秒** 将蒜末炒出香味",
      "heat": "中火"
    },
    {
      "text": "放入五花肉和 5ml 生抽，中火翻炒 **30 秒** 将肉炒熟并上色",
      "heat": "中火"
    },
    {
      "text": "将蒜苔放入锅内并加入 10ml 生抽，翻炒 **30 秒**"
    },
    {
      "text": "锅内加入 20g 水，中火翻炒 **5 分钟** 将蒜苔炒至稍稍变软",
      "minutes": 5,
      "heat": "中火"
    },
    {
      "text": "最后加入 2g 食盐，中火翻炒 **30 秒**，即可出锅装盘",
      "heat": "中火"
    }
  ],
  "tips": [
    "加入食盐前可尝一下咸淡，自行决定是否增减盐量",
    "选用五花肉薄片是因为切肉简单且不用腌制即可入味"
  ],
