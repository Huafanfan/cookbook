{
  "id": "jiang-pai-gu",
  "name": "酱排骨",
  "category": "家常菜",
  "tags": [
    "下饭",
    "重口"
  ],
  "summary": "酱排骨色泽酱红，肉质酥烂，骨香浓郁，汁浓味鲜，咸中带甜，是一道经典的家常菜。排骨富含优质蛋白质和钙质，营养均衡。制作涉及炒糖色和较长时间炖煮，对新手有一定挑战，但只要按步骤操作，也能顺利掌握。预计从备料到出锅约需 1 小时。",
  "difficulty": 3,
  "servings": 2,
  "ingredients": [
    {
      "name": "排骨",
      "amount": 300,
      "unit": "g"
    },
    {
      "name": "五香粉",
      "amount": 20,
      "unit": "g"
    },
    {
      "name": "料酒",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "食用油",
      "amount": 30,
      "unit": "ml"
    },
    {
      "name": "白砂糖",
      "amount": 15,
      "unit": "g"
    },
    {
      "name": "老抽",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "生抽",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "蚝油",
      "amount": 5,
      "unit": "ml"
    },
    {
      "name": "小米椒",
      "amount": 1,
      "unit": "个"
    },
    {
      "name": "蒜",
      "amount": 2,
      "unit": "粒"
    },
    {
      "name": "姜",
      "amount": 2,
      "unit": "片"
    }
  ],
  "steps": [
    {
      "text": "起锅烧热水，放入排骨、姜片、料酒，煮开后用勺子舀去白色油沫，2-3 分钟后出锅",
      "minutes": 2
    },
    {
      "text": "冷水清洗排骨，清洗 2-3 遍"
    },
    {
      "text": "小火起锅，加入食用油，加入白砂糖 ，轻轻搅拌到糖水变成黄色",
      "heat": "小火"
    },
    {
      "text": "倒入排骨翻炒 30 S 后，加入生抽、蚝油、五香粉、蒜、小米椒后翻炒 30 S 后，加入清水没过排骨"
    },
    {
      "text": "大火煮 30 分钟，加入老抽上色，再煮 10 分钟",
      "minutes": 30,
      "heat": "大火"
    },
    {
      "text": "起锅摆盘 ![酱排骨-预览图-1](./1.jpeg) ![酱排骨-预览图-2](./2.jpeg)"
    }
  ],
  "tips": [
    "增加味道的可以考虑加入豆瓣酱、番茄酱等",
    "大火煮时间可以根据每个人情况做调整",
    "煮排骨期间，可以顺道放入 2-3 个 鸡蛋一起煮，做成简易版卤蛋"
  ],
