{
  "id": "ka-li-fei-niu",
  "name": "咖喱肥牛",
  "category": "家常菜",
  "summary": "咖喱肥牛是一道浓郁下饭的家常菜，咖喱的辛香与肥牛的脂香融合，搭配土豆、胡萝卜等蔬菜，口感绵软醇厚。富含蛋白质、维生素和钙质，荤素搭配均衡。做法简单，对新手友好，一般只需 40 分钟就能端上餐桌，很适合作为便当菜。",
  "difficulty": 3,
  "servings": 2,
  "cookMinutes": 40,
  "ingredients": [
    {
      "name": "香叶",
      "amount": 1,
      "unit": "片"
    },
    {
      "name": "纯牛奶",
      "amount": 50,
      "unit": "ml"
    },
    {
      "name": "洋葱",
      "amount": 100,
      "unit": "g"
    },
    {
      "name": "胡萝卜",
      "amount": 150,
      "unit": "g"
    },
    {
      "name": "土豆",
      "amount": 200,
      "unit": "g",
      "note": "挺饱腹的，酌情添加"
    },
    {
      "name": "肥牛卷",
      "amount": 300,
      "unit": "g",
      "note": "喜欢吃肉就多来点"
    },
    {
      "name": "咖喱块",
      "amount": 2,
      "unit": "块",
      "note": "大约 100g"
    }
  ],
  "steps": [
    {
      "text": "洋葱切成条状、胡萝卜以及土豆切成块状，备用"
    },
    {
      "text": "烧一锅开水，水沸时将肥牛卷下锅，捞出血沫后放在一边沥水，备用"
    },
    {
      "text": "热锅，锅内放入 10ml - 15ml 食用油，**等待 10 秒让油温升高**"
    },
    {
      "text": "放入洋葱，翻炒至洋葱变软变透明"
    },
    {
      "text": "放入土豆以及胡萝卜**翻炒 2 分钟**",
      "minutes": 2
    },
    {
      "text": "加入冷水至淹没所有食材即可"
    },
    {
      "text": "将香叶、咖喱块投入锅中，盖上锅盖，**待水沸腾后将火调小然后等待直至土豆块以及胡萝卜块炖至软烂（可用筷子确认）**"
    },
    {
      "text": "加入肥牛卷以及牛奶，盖上锅盖再小火煮 2-3 分钟即可出锅（用勺子搅拌食材，注意力度，避免肥牛卷破碎）",
      "minutes": 2,
      "heat": "小火"
    }
  ],
  "tips": [
    "咖喱块不用捣碎，直接整块投入即可。",
    "操作时，需要注意搅拌食材，避免食材调味料不均匀。"
  ],
  "source": "HowToCook（Unlicense 公有领域）· https://github.com/Anduin2017/HowToCook"
}
