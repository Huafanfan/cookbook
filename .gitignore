# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 环境变量（含服务器配置，绝不入库）
.env
.env.*
# 但示例文件要入库：DEPLOYMENT 的 `cp .env.server.example .env.server` 依赖它
!.env.example
!.env.server.example

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
*.swp

# 本地数据快照（正式数据只放 data/，随仓库版本化的是菜谱 JSON）
data/**/*.tmp
data/backup/

# 菜品图片：约 60MB 二进制，进 git 会让仓库变重且无意义
# 备份靠打包 data/ 目录（见 docs/DEPLOYMENT.md），不靠 git
data/images/

# 用户状态（点赞/收藏）：运行期每次操作都会变，入库只会制造噪音
# 它同样是"数据"而不是"内容"，随 data/ 一起备份即可（见 ADR-0003）
data/user-state.json
data/user-state.json.tmp
data/user-state.json.broken

# 编辑器
.vscode/
.idea/
