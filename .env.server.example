# 服务器部署配置示例：复制为 .env.server 放在源码目录（与 compose.yaml 同级）
#   cp .env.server.example .env.server && chmod 600 .env.server
# 此示例只有变量名；实际 DS 密钥放受保护环境文件，绝不提交或放入镜像。

# 宿主机监听端口（服务器上已确认空闲）
COOKBOOK_PORT=18081

# 宿主机绑定地址：只监听局域网地址
COOKBOOK_BIND=192.168.1.2

# 容器内监听端口（一般不用改）
COOKBOOK_INTERNAL_PORT=8080

# 菜谱数据目录（宿主机侧），内含 recipes/ 与 images/
COOKBOOK_DATA_DIR=/srv/data/cookbook

# 创意工坊：服务端专用，未填密钥时仍可手动/JSON录入。
DS_BASE_URL=https://api.deepseek.com
DS_AUTH_TOKEN=
DS_MODEL=deepseek-flash
